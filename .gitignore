# =============================================================================
# Aakaar monorepo — root .gitignore
# Covers: aakaar/ (Python backend), admin-app/ + nbbl-app/ (Vite/React frontends),
# any additional frontend added at the repo root.
# =============================================================================

# -----------------------------------------------------------------------------
# OS / editor
# -----------------------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# -----------------------------------------------------------------------------
# Secrets / local env
# Track *.env.example; never track real .env files.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Frontends (admin-app, nbbl-app, and any future Vite/Next/React app)
# =============================================================================
node_modules/
dist/
build/
.vite/
.next/
.turbo/
.parcel-cache/
.cache/
coverage/
*.tsbuildinfo

# =============================================================================
# Python backend (aakaar/)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs
.venv/
venv/
env/
ENV/

# Packaging / build
*.egg
*.egg-info/
.eggs/
sdist/
wheels/
share/python-wheels/
MANIFEST

# Tooling caches
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml

# Jupyter / IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# pdm / pixi
.pdm-python
.pdm-build/
.pixi/

# =============================================================================
# Aakaar runtime data (filesystem object store, vector indexes, local sqlite)
# =============================================================================
aakaar/data/
*.sqlite
*.sqlite-*
*.db
*.rdb

# =============================================================================
# Misc
# =============================================================================
tmp/
.tmp/
*.bak
aakaar/data.zip
