# Aakaar agent configuration.
# Copy this file to aakaar-agent/.env and fill in your values, then start the
# agent with a SINGLE command:
#
#   scripts/start-agent.sh
#
# (start-agent.sh and start-all.sh both source aakaar-agent/.env automatically.)

# Enrollment key from the server's Agents page (or POST /agents/enroll).
# Shown exactly once; format is <agent_id>.<secret>.
AAKAAR_AGENT_KEY=70eb6e3f-cbcf-4ee3-b912-83bd4762313a.KUv1lZWYVWD8SL61jc60ciSlQXFuxAADKvUcy_XJINE
AAKAAR_BROWSER_IGNORE_HTTPS_ERRORS=true
AAKAAR_AGENT_BROWSER_IGNORE_HTTPS_ERRORS=true
#175bc85b-e63f-417f-a939-fb1a6be6a418.175bc85b-e63f-417f-a939-fb1a6be6a418.XJiBCp412ejPe9Nn_04Fi6CffHjVpmJsjvTcuyoKy4c
# Base WS URL of the server, or of the broker to relay through. The agent
# appends /ws/agents itself, so give only the base URL.
# Use the host's LAN IP (NOT 127.0.0.1) when the server runs on a DIFFERENT
# machine than this agent.
#   direct to the server:  ws://SERVER-HOST:8000
#   via the broker:        ws://BROKER-HOST:9300
AAKAAR_AGENT_SERVER=ws://127.0.0.1:9300

# Optional knobs:
# AAKAAR_AGENT_EXTRAS=gui,record   # pip extras for desktop / recording caps
# AAKAAR_AGENT_LOG_LEVEL=DEBUG     # bump verbosity to diagnose connection issues
# AAKAAR_AGENT_STRICT_TLS=1        # enforce TLS verification on the Chromium download
