# Aakaar backend configuration — copy to `.env` and edit.
# Every knob is an AAKAAR_* environment variable read by core/config.py.
# Leave a line unset to take the default shown in brackets.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite is the DEFAULT and needs nothing here. To use Postgres, uncomment the
# postgresql line (and `pip install -e '.[postgres]'` for the driver).
AAKAAR_DB_URL=sqlite:///./data/aakaar.sqlite
# AAKAAR_DB_URL=postgresql+psycopg://aakaar_app:CHANGE-ME@localhost:5432/aakaar
AAKAAR_DATA_DIR=./data

# ── Cache ───────────────────────────────────────────────────────────────────
# There is NO external cache to configure. The OIDC state store, OIDC discovery
# cache and JWKS key store are all in-process (single-node). Nothing to set.

# ── Auth: JWT signing ───────────────────────────────────────────────────────
# REQUIRED. Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AAKAAR_JWT_SECRET=change-me
AAKAAR_ACCESS_TTL_MIN=1440                 # access token TTL in minutes [1440]
# HS256 (default, shared secret) — or RS256 for production (asymmetric + JWKS):
# AAKAAR_JWT_ALG=RS256                     # [HS256]
# AAKAAR_JWT_KEY_DIR=/secure/aakaar/keys   # dir of <kid>.pem signing keys (RS256)
# AAKAAR_JWT_BOOTSTRAP_KEYS=true           # dev: generate a keypair if empty [false]
# AAKAAR_JWT_ISSUER=aakaar                 # `iss` claim []
# AAKAAR_JWT_AUDIENCE=aakaar-api           # `aud` claim [aakaar-api]

# ── Auth: MFA (TOTP) ────────────────────────────────────────────────────────
# AAKAAR_MFA_ISSUER=Aakaar                 # label shown in authenticator apps [Aakaar]
# AAKAAR_MFA_ENCRYPTION_KEY=               # Fernet key to encrypt TOTP secrets at rest.
#   generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'

# ── Auth: OIDC / SSO ────────────────────────────────────────────────────────
# AAKAAR_OIDC_ENABLED=true
# AAKAAR_OIDC_ISSUER=https://idp.example.com
# AAKAAR_OIDC_CLIENT_ID=
# AAKAAR_OIDC_CLIENT_SECRET=
# AAKAAR_OIDC_REDIRECT_URI=https://aakaar.example.com/auth/oidc/callback
# AAKAAR_OIDC_FRONTEND_CALLBACK_PATH=/auth/callback
# AAKAAR_OIDC_DEFAULT_TENANT_SLUG=         # tenant new OIDC users land in []
# AAKAAR_OIDC_LINK_BY_VERIFIED_EMAIL=false # link to an existing user by verified email [false]

# ── Row-Level Security (Postgres only; no-op on SQLite) ─────────────────────
# AAKAAR_RLS_STRICT=false                  # true = deny when no tenant/system scope [false]

# ── First superuser (bootstrapped on startup if no superuser exists) ────────
AAKAAR_SUPERUSER_EMAIL=admin@example.com
AAKAAR_SUPERUSER_PASSWORD=change-me

# ── LLM / embeddings (planner) ──────────────────────────────────────────────
# Unset OPENAI_API_KEY to run with the offline fake LLM (dev only).
OPENAI_API_KEY=
OPENAI_BASE_URL=                           # leave empty for the default OpenAI endpoint
AAKAAR_LLM_MODEL=gpt-4.1-mini
AAKAAR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# AAKAAR_HF_OFFLINE=false                   # load embeddings only from local cache [false]

# ── Browser / runtime ───────────────────────────────────────────────────────
# AAKAAR_BROWSER_POOL=playwright            # "playwright" | "none" [playwright]
AAKAAR_BROWSER_HEADLESS=true
AAKAAR_LIVE_SCREENSHOTS=true
AAKAAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Toggles (all default ON) ────────────────────────────────────────────────
# AAKAAR_METRICS_ENABLED=true
# AAKAAR_RATE_LIMIT_ENABLED=true
# AAKAAR_SCHEDULER_ENABLED=true
# AAKAAR_REMOTE_EXEC_ENABLED=true
